# ── Krishi Sangam server environment ────────────────────────────
# Copy this file to server/.env and fill in real values.

# Supabase project connection string (Settings → Database → Connection string)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.example:YOUR_PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service role key (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Set to false only for a local Postgres without TLS
# DATABASE_SSL=false

# JWT secret used to sign session tokens (change in production!)
JWT_SECRET=change_this_to_a_long_random_string

# ── 2Factor.in (OTP delivery, primary) ───────────────────────
# Set to send OTP codes as real SMS via 2Factor.in (https://2factor.in).
# Leave empty → falls through to TextBee/Msg91/dev mode (devOtp).
#   TFACTOR_API_KEY       → 2Factor.in dashboard → API key
#   TFACTOR_TEMPLATE_NAME → optional DLT template name (V2 only; V1 works without)
TFACTOR_API_KEY=
# TFACTOR_TEMPLATE_NAME=

# ── TextBee (OTP delivery, fallback) ──────────────────────────
# A free Android SMS gateway (~300 SMS/month, needs an Android phone with
# the TextBee app + a SIM card).
#   TEXTBEE_API_KEY   → TextBee dashboard → device API key
#   TEXTBEE_DEVICE_ID → registered device ID (dashboard)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# ── Msg91 SMS (OTP delivery, fallback) ────────────────────────
#   MSG91_AUTH_KEY        → Msg91 dashboard → Settings → API Keys
#   MSG91_OTP_TEMPLATE_ID → approved OTP template containing {{otp}} (SMS → OTP templates)
#   MSG91_SENDER_ID       → optional 6-char sender ID used by your template
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Server port (defaults to 3001)
# PORT=3001
