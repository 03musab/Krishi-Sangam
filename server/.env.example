# ── Krishi Sangam server environment ────────────────────────────
# Copy this file to server/.env and fill in real values.

# Supabase project connection string (Settings → Database → Connection string)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.example:YOUR_PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service role key (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Set to false only for a local Postgres without TLS
# DATABASE_SSL=false

# JWT secret used to sign session tokens (change in production!)
JWT_SECRET=change_this_to_a_long_random_string

# ── Knock SMS (OTP delivery) ────────────────────────────────
# Set these to send OTP codes as real SMS. When KNOCK_API_KEY is unset,
# the API falls back to dev mode and returns the OTP in the response.
# Sign up: https://dashboard.knock.app/signup  →  Platform → API keys
# Then configure an SMS provider + the 'otp-verification' workflow in the dashboard.
KNOCK_API_KEY=
# Optional — only needed if you verify webhook signatures
# KNOCK_SIGNING_KEY=

# Server port (defaults to 3001)
# PORT=3001
